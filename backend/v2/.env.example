PORT=8080
# Firebase Authentication project. The Android app signs users in once; the API verifies Firebase ID tokens.
SAWT_FIREBASE_PROJECT_ID=

# EasyVoice free API: 5,000 characters/day shared with its web app; Arabic ar_m1/ar_f1 are beta.
EASYVOICE_API_KEY=
EASYVOICE_FREE_API_CONFIRMED=false

# Gemini Developer API free tier. Store only on the server, never in the APK or repository.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL_QUALITY=gemini-3.8-flash-tts
GEMINI_MODEL_FAST=gemini-3.8-flash-lite-tts
# Gemini prebuilt voice timbres are configurable; verify gender/style by listening to samples.
GEMINI_VOICE_MALE=Puck
GEMINI_VOICE_FEMALE=Kore

# Azure must be an explicitly confirmed F0 resource. S0 is rejected by the router.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TIER=F0
AZURE_SPEECH_FREE_TIER_CONFIRMED=false

# ElevenLabs Free is personal/non-commercial only, 10k monthly credits, and no free API voice library.
# Keep disabled for any public/commercial distribution.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_FREE_PERSONAL_CONSENT=false
SAWT_DISTRIBUTION_SCOPE=public
